# Extracted client data. Enormous, fully reproducible from builds.json.
out/

# Cloned third-party tools (WTL, TACTSharp, DBCD, WoWDBDefs, listfile, TACTKeys).
vendor/

# Local Claude Code state -- machine-specific paths and permissions.
# The wow-query skill IS committed; only local settings are ignored.
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]

# Generated diff output. Every file here is reproducible from builds.json plus
# a local extraction, and the HTML renders run to hundreds of KB of inlined
# base64 icon art that churns on every regeneration.
reports/

# Quest XP sweep. The addon, its parser and the generator ARE tracked -- they
# are source, not output, and nothing regenerates them. Only the artifacts are
# ignored: raw questcache.wdb captures copied out of the client between
# sessions, and the CSVs the parser builds from them.
questxp/cache/
questxp/out/
questxp/__pycache__/

# Committed, never ignore — listed for intent, these are the deliverables:
#   builds.json   manifest index, unrecoverable once Blizzard rotates a build
#   scripts/      the pipeline
!builds.json
